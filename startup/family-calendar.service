[Unit]
Description=Family Calendar Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/family_calendar
# waitress is a production WSGI server; wsgi.py starts the PIR sensor, the
# display service and the background sync exactly like `python -m src.main`.
# One thread is held per connected display (the SSE stream), so 16 is plenty.
ExecStart=/home/pi/family_calendar/.venv/bin/waitress-serve --listen=0.0.0.0:5000 --threads=16 --channel-timeout=600 wsgi:app
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

Environment="PYTHONPATH=/home/pi/family_calendar"
Environment="PYTHONUNBUFFERED=1"

# Resource limits. Photo ingest decodes one phone photo at a time; 768M leaves
# headroom for that on top of the ~120M steady state.
LimitNOFILE=4096
MemoryMax=768M

# Hardware access.
#   gpio  -> /dev/gpiochip* for the PIR sensor (Raspberry Pi 5 has no /dev/gpiomem)
#   video -> /sys/class/backlight/*/brightness (with the udev rule in startup/)
#   i2c   -> ddcutil for HDMI monitors that support DDC/CI
# No DeviceAllow= lines on purpose: with any DeviceAllow present systemd switches
# to a closed device policy, and a glob like /dev/gpiochip* is not expanded, so
# the previous unit silently denied the very device the sensor needed.
SupplementaryGroups=gpio video i2c

# Hardening. ProtectSystem=strict leaves /dev, /proc and /sys writable subject
# to normal permissions, which is what the backlight and GPIO need.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/family_calendar
PrivateTmp=true

KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
