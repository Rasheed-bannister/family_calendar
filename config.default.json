{
  "app": {
    "debug": false,
    "host": "0.0.0.0",
    "port": 5000,
    "secret_key": "your-secret-key-here-change-this-in-production",
    "use_reloader": false,
    "environment": "production",
    "family_name": "Bannister Family",
    "timezone": null
  },
  "weather": {
    "latitude": 40.75901,
    "longitude": -73.984474,
    "timezone": "America/New_York",
    "cache_duration": 600,
    "offline_fallback": true,
    "request_timeout_seconds": 10.0
  },
  "pir_sensor": {
    "enabled": true,
    "gpio_pin": 18,
    "debounce_time": 2.0,
    "simulation_mode": false
  },
  "display": {
    "day": {
      "dim_after_seconds": 3600,
      "hide_ui_after_seconds": 3605,
      "brightness": 0.6
    },
    "night": {
      "dim_after_seconds": 5,
      "hide_ui_after_seconds": 10,
      "brightness": 0.2
    },
    "night_start_hour": 21,
    "night_end_hour": 6,
    "backlight": {
      "backend": "auto",
      "device": null
    },
    "tick_seconds": 1.0
  },
  "slideshow": {
    "interval_seconds": 30,
    "transition_seconds": 2,
    "ken_burns": true,
    "max_dimension": 2048
  },
  "google": {
    "sync_interval_minutes": 1,
    "max_retry_attempts": 3,
    "offline_mode_enabled": true
  },
  "scheduler": {
    "enabled": true
  },
  "ui": {
    "show_pir_feedback": true,
    "touch_optimized": true,
    "animation_duration_ms": 300
  },
  "paths": {
    "photos_dir": "src/static/photos",
    "credentials_dir": "src/google_integration"
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "calendar.log",
    "max_bytes": 10485760,
    "backup_count": 5
  }
}
